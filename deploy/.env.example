# PostgreSQL 数据库连接
DATABASE_URL=postgres://axpoint:axpoint_secret@localhost:5432/xbluenode

# AxPoint Core (Rust) 服务端口与前端静态资源目录
AXPOINT_BIND_ADDR=0.0.0.0:9995
WEB_DIST_DIR=../xbluenode-web/dist

# AxPoint Parser (Python Sidecar) 地址
PARSER_BASE_URL=http://127.0.0.1:8001

# 容器镜像仓库与版本标签（支持切换企业私有 Harbor/ACR）
AXPOINT_REGISTRY=dex2all
AXPOINT_VERSION=v0.1.0
AXPOINT_PARSER_VERSION=v0.1.0

# 大语言模型配置 (OpenAI 兼容协议: DashScope / DeepSeek / Ollama / vLLM)
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=qwen-max

# Embedding 模型配置 (支持任意维度，自动适配 hg_embeddings)
EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-replace-me
EMBED_MODEL=text-embedding-v4
# 可选：显式指定维度（留空则由 EmbeddingAdapter 自动探测）
EMBED_DIM=
