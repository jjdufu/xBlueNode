# ==============================================================================
# xBlueNode / AxPoint Environment Configuration Template
# Reference: docs/standards/A1-CONVENTIONS-ENUMS-ROUTES.md §10
# ==============================================================================

AXPOINT_ENV=development

# PostgreSQL Connections (Application Role vs Migration Owner vs DuckLake Catalog)
POSTGRES_PASSWORD=axpoint_secret
AXPOINT_APP_DB_PASSWORD=axpoint_app_secret
AXPOINT_LAKE_DB_PASSWORD=axpoint_lake_secret
DATABASE_URL=postgres://axpoint_app:axpoint_app_secret@localhost:5432/xbluenode
MIGRATION_DATABASE_URL=postgres://axpoint:axpoint_secret@localhost:5432/xbluenode
AXPOINT_MIGRATE_ON_START=true
AXPOINT_LAKE_CATALOG_DSN=postgres://axpoint_lake:axpoint_lake_secret@localhost:5432/xbluenode

# AxPoint Core (Rust) & Prometheus Metrics
AXPOINT_BIND_ADDR=0.0.0.0:9995
AXPOINT_METRICS_ADDR=127.0.0.1:9464
WEB_DIST_DIR=../xbluenode-web/dist
AXPOINT_WORKERS=4
AXPOINT_MAX_UPLOAD_MB=512

# AxPoint Parser Sidecar (Python)
PARSER_BASE_URL=http://127.0.0.1:8001
AXPOINT_DATA_ROOT=/var/lib/axpoint
AXPOINT_MODEL_PATH=/var/lib/axpoint/models
AXPOINT_PARSE_TIMEOUT_S=300
AXPOINT_PDF_MAX_PAGES=2000
AXPOINT_CHART_WORKERS=2

# AxGuard Security & Tokens (>= 32 random bytes in non-template deployments)
AXPOINT_INTERNAL_TOKEN=replace-with-at-least-32-byte-internal-token
AXPOINT_DEV_TOKEN=replace-with-at-least-32-byte-dev-static-token
AXPOINT_CREDENTIAL_KEYS=
AXPOINT_MASK_KEYS=
AXPOINT_JWT_PRIVATE_KEY_PATH=
AXPOINT_JWT_PUBLIC_KEYS_DIR=

# OIDC Authentication (Optional)
AXPOINT_OIDC_ISSUER=
AXPOINT_OIDC_CLIENT_ID=
AXPOINT_OIDC_CLIENT_SECRET=
AXPOINT_OIDC_REDIRECT_URL=
AXPOINT_OIDC_AUTO_PROVISION=false
AXPOINT_OIDC_USERNAME_CLAIM=preferred_username
AXPOINT_OIDC_ROLE_MAP=

# DuckDB OLAP Tenant Pool
AXPOINT_DUCKDB_TENANT_CACHE=32
AXPOINT_DUCKDB_MEMORY=2GB

# LLM & Multi-Dimension Embedding (OpenAI-Compatible)
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=qwen-max
EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-replace-me
EMBED_MODEL=text-embedding-v4
EMBED_DIM=
AXPOINT_LLM_CASSETTE=

# External Delivery, Maps & Operations
AXPOINT_PUBLIC_HOST=
AXPOINT_MAP_TILE_URL=
AXPOINT_BACKUP_DIR=/var/lib/axpoint/backups
AXPOINT_BACKUP_KEEP_DAYS=14
AXPOINT_BACKUP_CMD=

# Container Registry & Variants
AXPOINT_REGISTRY=dex2all
AXPOINT_VERSION=v0.3.0
AXPOINT_PARSER_VERSION=v0.3.0
AXPOINT_PARSER_VARIANT=full

# Observability & Logging
OTEL_EXPORTER_OTLP_ENDPOINT=
RUST_LOG=axpoint_server=info,info
