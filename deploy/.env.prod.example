# xBlueNode 生产环境必填与可选配置示例（复制为 deploy/.env.prod 并替换为高熵随机密钥）
# 注意：AXPOINT_ENV=production 时，Core 启动自检将拒绝缺失必填项、使用示例默认口令或设置 AXPOINT_DEV_TOKEN。

AXPOINT_ENV=production
AXPOINT_PUBLIC_HOST=xbluenode.example.com

# 数据库口令（分别对应属主角色 axpoint、应用角色 axpoint_app、湖目录角色 axpoint_lake）
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_OWNER_DB_PASSWORD_MIN_24_CHARS
AXPOINT_APP_DB_PASSWORD=REPLACE_WITH_STRONG_APP_DB_PASSWORD_MIN_24_CHARS
AXPOINT_LAKE_DB_PASSWORD=REPLACE_WITH_STRONG_LAKE_DB_PASSWORD_MIN_24_CHARS
POSTGRES_SHARED_BUFFERS=2GB

# 内部服务通信与静态加密主密钥（32 字节随机数 Base64 编码，格式 <kid>:<base64>）
AXPOINT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_URLSAFE_TOKEN_AT_LEAST_32_BYTES
AXPOINT_CREDENTIAL_KEYS=1:REPLACE_WITH_32_BYTE_BASE64_AES256GCM_KEY
AXPOINT_MASK_KEYS=1:REPLACE_WITH_32_BYTE_BASE64_HMAC_MASK_KEY

# Ed25519 JWT 签名私钥与验证公钥目录（由 scripts/ops/gen-jwt-key.sh 生成）
AXPOINT_JWT_PRIVATE_KEY_PATH=/etc/axpoint/jwt/private.pem
AXPOINT_JWT_PUBLIC_KEYS_DIR=/etc/axpoint/jwt/public

# 主模型与向量模型配置
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=REPLACE_WITH_PRODUCTION_LLM_API_KEY
LLM_MODEL=qwen-max
EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=REPLACE_WITH_PRODUCTION_EMBED_API_KEY
EMBED_MODEL=text-embedding-v4

# 上传大小与备份保留天数
AXPOINT_MAX_UPLOAD_MB=512
AXPOINT_BACKUP_KEEP_DAYS=14

# 可选：企业 OIDC 单点登录
# AXPOINT_OIDC_ISSUER_URL=https://idp.example.com/realms/corp
# AXPOINT_OIDC_CLIENT_ID=xbluenode-web
# AXPOINT_OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# AXPOINT_OIDC_REDIRECT_URI=https://xbluenode.example.com/api/auth/oidc/callback
# AXPOINT_OIDC_DISPLAY_NAME=企业统一身份认证

# 可选：地图瓦片服务与 OpenTelemetry 追踪导出
# AXPOINT_MAP_TILE_URL=https://tiles.example.com/styles/basic/{z}/{x}/{y}.png
# AXPOINT_MAP_TILE_ORIGIN=https://tiles.example.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
