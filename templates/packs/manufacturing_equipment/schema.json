{
  "node_types": [
    {
      "name": "Line",
      "display_name": "生产产线",
      "description": "离散或流程制造车间自动化产线",
      "icon": "layers",
      "color": "#2563eb",
      "title_template": "{prop.line_name}",
      "properties": [
        {
          "name": "line_name",
          "display_name": "产线名称",
          "description": "产线标准名称",
          "data_type": "STRING",
          "kind": "ATTRIBUTE",
          "required": false,
          "pii_category": "NONE"
        },
        {
          "name": "workshop",
          "display_name": "所属车间",
          "description": "产线所在厂房车间",
          "data_type": "STRING",
          "kind": "ATTRIBUTE",
          "required": false,
          "pii_category": "NONE"
        },
        {
          "name": "availability",
          "display_name": "时间稼动率",
          "description": "设备实际运行时间占计划工作时间比例",
          "unit": "ratio",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE"
        },
        {
          "name": "performance",
          "display_name": "性能稼动率",
          "description": "实际加工节拍相对于标准节拍效率",
          "unit": "ratio",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE"
        },
        {
          "name": "quality",
          "display_name": "良品率",
          "description": "一次交检合格品占比",
          "unit": "ratio",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE"
        },
        {
          "name": "oee",
          "display_name": "设备综合效率",
          "description": "产线 OEE（availability * performance * quality）",
          "unit": "ratio",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE"
        },
        {
          "name": "max_spindle_temp",
          "display_name": "产线最高主轴温度",
          "description": "下属机台主轴温度最大值聚合",
          "unit": "℃",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE"
        }
      ],
      "agg_rules": [
        {
          "target_metric": "max_spindle_temp",
          "op": "MAX",
          "via_link_type": "HAS_MACHINE",
          "direction": "OUT",
          "source_type_name": "Machine",
          "source_metric": "spindle_temp",
          "weight_by_link": false
        }
      ],
      "derived_rules": [
        {
          "target_metric": "oee",
          "expression": "availability * performance * quality",
          "enabled": true
        }
      ],
      "sync_to_knowledge": true,
      "pos_x": 120.0,
      "pos_y": 180.0
    },
    {
      "name": "Machine",
      "display_name": "机台设备",
