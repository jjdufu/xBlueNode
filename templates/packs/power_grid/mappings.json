      "metrics": {
        "generation_mw": "generation_mw",
        "spinning_reserve_mw": "spinning_reserve_mw"
      },
      "geo": {
        "lng_column": "lng",
        "lat_column": "lat"
      },
      "links": [],
      "on_source_delete": "KEEP",
      "mode": "FULL"
    },
    {
