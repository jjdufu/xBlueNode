    {
      "name": "FEEDS_TRANSFORMER",
      "src_type_name": "Substation",
      "dst_type_name": "DistTransformer",
      "impact_weight": 0.85,
      "cardinality": "ONE_TO_MANY",
      "description": "变电站10kV馈线向台区配变供电并实时监测电流、负载率与线损",
      "properties": [
        {
          "name": "current_amp",
