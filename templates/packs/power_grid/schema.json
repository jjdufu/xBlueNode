          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE",
          "maturity": "CONFIRMED"
        }
      ],
      "derived_rules": [
        {
          "target_metric": "line_load_ratio",
          "expression": "src.load_ratio * 0.65 + dst.demand_mw * 0.08 + current_amp * 0.0005",
          "path_kind": "VERTEX_TO_EDGE",
          "enabled": true,
          "maturity": "CONFIRMED"
        },
        {
          "target_metric": "line_loss_mw",
          "expression": "line_load_ratio * dst.demand_mw * 0.04",
          "path_kind": "VERTEX_TO_EDGE",
          "enabled": true,
          "maturity": "CONFIRMED"
        }
      ],
      "propagation": {
        "rules": [
