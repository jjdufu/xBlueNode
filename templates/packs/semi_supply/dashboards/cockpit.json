      "encoding": {},
      "options": {
        "semantic_zone": "DECISION",
        "markdown": "- **安全晶圆调配**：针对高优车规大单执行 `reallocate_safety_wafer`\n- **航空包机快通**：口岸滞留超 24h 执行 `expedite_air_charter`"
      },
      "drill": [],
      "refresh_mode": "MANUAL",
      "refresh_seconds": 60
    }
  ]
