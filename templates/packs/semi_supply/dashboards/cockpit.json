        "kind": "NODE_METRIC",
        "type_name": "LithoTool",
        "metric": "oee_pct",
        "agg": "AVG",
        "grain": "HOUR",
        "time_range": "LAST_7_DAYS",
        "group_by": "time"
      },
      "encoding": { "x": "ts", "y": "value" },
      "options": { "semantic_zone": "INSIGHT", "unit": "%" },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "BAR_CHART",
      "title": "区域分拨仓可用芯片库存",
      "position": { "x": 7, "y": 9, "w": 5, "h": 5 },
      "data_source": {
        "kind": "NODE_METRIC",
        "type_name": "RegionalHub",
        "metric": "chip_inventory_k",
        "agg": "LAST",
        "grain": "DAY",
        "time_range": "LAST_7_DAYS",
        "group_by": "node"
      },
      "encoding": { "x": "group_key", "y": "value" },
      "options": { "semantic_zone": "INSIGHT", "unit": "千颗" },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "ALERT_LIST",
      "title": "制程与通关异常告警",
      "position": { "x": 0, "y": 14, "w": 8, "h": 5 },
      "data_source": {
        "kind": "ALERTS",
        "status": ["OPEN", "ACK"],
        "severity": ["WARN", "CRITICAL"],
        "limit": 20
      },
      "encoding": {},
      "options": { "semantic_zone": "DECISION" },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "MARKDOWN_NOTE",
      "title": "应急调度预案",
      "position": { "x": 8, "y": 14, "w": 4, "h": 5 },
