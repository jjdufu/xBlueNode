      "agg_rules": [
        {
          "target_metric": "avg_tool_oee",
          "op": "AVG",
          "via_link_type": "EQUIPPED_WITH",
          "direction": "OUT",
          "source_type_name": "LithoTool",
          "source_metric": "oee_pct",
          "weight_by_link": false,
          "maturity": "CONFIRMED"
        }
      ],
      "derived_rules": [
        {
          "target_metric": "effective_good_wpm",
          "expression": "wafer_starts_wpm * (fab_yield_pct / 100.0) * if(avg_tool_oee > 0, avg_tool_oee / 100.0, 0.9)",
          "enabled": true,
          "maturity": "CONFIRMED"
        }
      ],
      "actions": [
        {
          "name": "reallocate_safety_wafer",
          "display_name": "调配安全晶圆",
          "description": "动用厂内安全储备晶圆补充紧急流片投产需求",
          "parameters": [
            {
              "name": "qty",
              "display_name": "调配晶圆片数",
              "data_type": "FLOAT64",
              "required": false,
              "default_value": 500.0,
              "description": "本次投入紧急排产的安全储备晶圆数量"
            }
          ],
          "precondition_expr": "safety_wafer_stock >= param.qty and param.qty > 0",
          "side_effect_tier": "SELF_ONLY",
          "mutations": [
            {
              "target": "self.safety_wafer_stock",
              "expression": "safety_wafer_stock - param.qty"
            },
            {
              "target": "self.wafer_starts_wpm",
              "expression": "wafer_starts_wpm + param.qty"
            }
          ],
          "required_permission": "ACTION_EXECUTE",
          "require_approval": false,
          "maturity": "CONFIRMED"
        }
      ],
