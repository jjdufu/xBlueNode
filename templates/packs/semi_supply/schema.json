          "unit": "%",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE",
          "maturity": "CONFIRMED"
        },
        {
          "name": "effective_good_wpm",
          "display_name": "折合良片月产出",
          "description": "结合月投片量、综合良率与机台效率折算的有效良片产出",
          "unit": "片/月",
          "data_type": "FLOAT64",
          "kind": "METRIC",
          "required": false,
          "pii_category": "NONE",
          "maturity": "CONFIRMED"
        }
