{
  "key": "cockpit",
  "name": "集团授信与互保风控看板",
  "slug": "fin-risk-cockpit",
  "description": "覆盖集团总敞口、不良逾期率、6万行对公流水多维透视、交叉互保传染图谱及一键冻结额度",
  "theme": "light",
  "canvas": {
    "cols": 12,
    "row_height": 32,
    "screen_width": 1920,
    "screen_height": 1080,
    "zone_layout": "STANDARD_FIVE_ZONE",
    "compact_mode": "VERTICAL_COMPACT"
  },
  "widgets": [
    {
      "widget_kind": "MARKDOWN_NOTE",
      "title": "风控联防控制栏",
      "position": { "x": 0, "y": 0, "w": 12, "h": 2 },
      "data_source": { "kind": "STATIC", "columns": [], "rows": [] },
      "encoding": {},
      "options": {
        "semantic_zone": "CONTROL",
        "markdown": "**集团授信与互保联防看板** · 实时穿透控股/互保环形团伙、60,000 笔对公资金划转多维透视与跨分行逾期动态联防"
      },
      "drill": [],
      "refresh_mode": "MANUAL",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "KPI_CARD",
      "title": "对公划转总金额",
      "position": { "x": 0, "y": 2, "w": 3, "h": 3 },
      "data_source": {
        "kind": "SQL",
        "sql": "SELECT ROUND(SUM(transfer_amt), 2) AS value FROM fin_corp_wire_transfers"
      },
      "encoding": { "y": "value" },
      "options": { "semantic_zone": "KPI", "unit": "万元", "decimals": 2 },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "KPI_CARD",
      "title": "对公流水总笔数",
      "position": { "x": 3, "y": 2, "w": 3, "h": 3 },
      "data_source": {
        "kind": "SQL",
        "sql": "SELECT COUNT(*) AS value FROM fin_corp_wire_transfers"
      },
      "encoding": { "y": "value" },
      "options": { "semantic_zone": "KPI", "unit": "笔", "decimals": 0 },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "KPI_CARD",
      "title": "高风险划转占比",
      "position": { "x": 6, "y": 2, "w": 3, "h": 3 },
      "data_source": {
        "kind": "SQL",
        "sql": "SELECT ROUND(SUM(CASE WHEN risk_tier = 'HIGH' THEN 1.0 ELSE 0.0 END) / COUNT(*), 4) AS value FROM fin_corp_wire_transfers"
      },
      "encoding": { "y": "value" },
      "options": { "semantic_zone": "KPI", "unit": "ratio", "decimals": 4 },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "KPI_CARD",
      "title": "单笔峰值划转额",
      "position": { "x": 9, "y": 2, "w": 3, "h": 3 },
      "data_source": {
        "kind": "SQL",
        "sql": "SELECT ROUND(MAX(transfer_amt), 2) AS value FROM fin_corp_wire_transfers"
      },
      "encoding": { "y": "value" },
      "options": { "semantic_zone": "KPI", "unit": "万元", "decimals": 2 },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "GRAPH_TOPOLOGY",
      "title": "集团控股与交叉互保传染拓扑",
      "position": { "x": 0, "y": 5, "w": 6, "h": 9 },
      "data_source": {
        "kind": "GRAPH",
        "type_names": ["CorpGroup", "LegalEntity", "BeneficialOwner"],
        "link_types": ["CONTROLS", "HOLDS_EQUITY", "CROSS_GUARANTEES", "TRANSFERS_FUNDS"],
        "color_metric": "overdue_ratio",
        "limit": 260
      },
      "encoding": {},
      "options": { "semantic_zone": "SCENE" },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "PIVOT_TABLE",
      "title": "6万行对公流水多维透视",
      "position": { "x": 6, "y": 5, "w": 6, "h": 9 },
      "data_source": {
        "kind": "PIVOT",
        "spec": {
          "dataset": "fin_corp_wire_transfers",
          "rows": [
            { "field": "branch_dept", "label": "分行部门" },
            { "field": "industry", "label": "所属行业" }
          ],
          "columns": [
            { "field": "risk_tier", "label": "风险等级" }
          ],
          "values": [
            { "field": "transfer_amt", "agg": "SUM", "alias": "划转总额(万)", "format": "0,0.00" },
            { "field": "tx_count", "agg": "SUM", "alias": "划转笔数", "format": "0,0" }
          ],
          "subtotals": true,
          "grand_total": true,
          "row_limit": 500,
          "column_limit": 20
        }
      },
      "encoding": {},
      "options": {
        "semantic_zone": "INSIGHT",
        "data_bars": true,
        "heatmap": true
      },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "ALERT_LIST",
      "title": "逾期越界与互保传染告警",
      "position": { "x": 0, "y": 14, "w": 8, "h": 5 },
      "data_source": {
        "kind": "ALERTS",
        "status": ["OPEN", "ACK"],
        "severity": ["WARN", "CRITICAL"],
        "limit": 20
      },
      "encoding": {},
      "options": { "semantic_zone": "DECISION" },
      "drill": [],
      "refresh_mode": "LIVE",
      "refresh_seconds": 60
    },
    {
      "widget_kind": "ACTION_BUTTON",
      "title": "冻结授信额度",
      "position": { "x": 8, "y": 14, "w": 4, "h": 5 },
      "data_source": {
        "kind": "ACTION",
        "action_type": "RUN_FLOW",
        "flow_id": null,
        "input_schema": {
          "type": "object",
          "properties": {
            "freeze_amt": {
              "type": "number",
              "title": "冻结额度(万元)",
              "default": 500
            }
          }
        },
        "confirm_text": "确认对逾期越界关联法人冻结未用授信额度并重算互保敞口？"
      },
      "encoding": {},
      "options": { "semantic_zone": "DECISION" },
      "drill": [],
      "refresh_mode": "MANUAL",
      "refresh_seconds": 60
    }
  ]
}
