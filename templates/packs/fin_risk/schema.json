              "data_type": "FLOAT64",
              "required": true,
              "description": "本次紧急冻结的授信额度（万元）"
            }
          ],
          "precondition_expr": "overdue_ratio >= 0.0 and credit_limit >= param.freeze_amt and param.freeze_amt > 0",
          "side_effect_tier": "SELF_ONLY",
          "mutations": [
            {
              "target": "self.credit_limit",
              "expression": "credit_limit - param.freeze_amt"
            },
            {
              "target": "self.frozen_amount",
              "expression": "frozen_amount + param.freeze_amt"
            }
          ],
          "required_permission": "ACTION_EXECUTE",
          "require_approval": false,
          "maturity": "CONFIRMED"
        }
