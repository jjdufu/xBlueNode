          "display_name": "分流改派",
          "description": "当原目标院区急诊饱和时，将急救车就近改派至邻近低负荷三甲院区",
          "parameters": [
            {
              "name": "eta_delta",
              "display_name": "预计时间变化",
              "data_type": "FLOAT64",
              "required": false,
              "default_value": -4.0,
              "description": "改派新院区后的预计抵院分钟调整量"
            }
          ],
          "precondition_expr": "eta_minutes <= 35",
          "side_effect_tier": "SELF_ONLY",
          "mutations": [
            {
              "target": "self.eta_minutes",
              "expression": "max(3.0, eta_minutes + param.eta_delta)"
            },
            {
              "target": "self.dispatch_load",
              "expression": "max(1.0, dispatch_load)"
            }
          ],
          "required_permission": "ACTION_EXECUTE",
          "require_approval": false,
          "maturity": "CONFIRMED"
        }
      ],
      "sync_to_knowledge": true,
      "pos_x": 80.0,
