        {
          "target_metric": "avg_dept_occupancy_pct",
          "op": "AVG",
          "via_link_type": "HAS_CLINICAL_DEPT",
          "direction": "OUT",
          "source_type_name": "ClinicalDept",
          "source_metric": "bed_occupancy_pct",
          "weight_by_link": false,
          "maturity": "CONFIRMED"
        }
      ],
      "derived_rules": [
        {
          "target_metric": "campus_saturation_idx",
          "expression": "max(0.0, min(100.0, ed_wait_minutes * 0.8 + if(avg_dept_occupancy_pct > 0, avg_dept_occupancy_pct * 0.6, 45.0) - min(30.0, total_free_beds * 0.3)))",
          "enabled": true,
          "maturity": "CONFIRMED"
        }
      ],
      "actions": [
        {
          "name": "activate_surge_beds",
          "display_name": "启用应急加床",
          "description": "一键开启院区应急机动病区加床并提升响应等级，实时补充可用床位池",
          "parameters": [
            {
              "name": "added_beds",
              "display_name": "新增应急床位数",
              "data_type": "FLOAT64",
              "required": false,
              "default_value": 24.0,
              "description": "本次机动病区开放释放的应急床位张数"
            },
            {
              "name": "target_surge_level",
              "display_name": "目标响应等级",
              "data_type": "FLOAT64",
              "required": false,
              "default_value": 2.0,
              "description": "升级后的院区应急响应等级（1～3）"
            }
          ],
          "precondition_expr": "param.added_beds > 0 and param.target_surge_level >= 1",
          "side_effect_tier": "SELF_ONLY",
          "mutations": [
            {
              "target": "self.total_free_beds",
              "expression": "total_free_beds + param.added_beds"
            },
            {
              "target": "self.surge_level",
              "expression": "param.target_surge_level"
            }
          ],
          "required_permission": "ACTION_EXECUTE",
          "require_approval": false,
          "maturity": "CONFIRMED"
        }
